# Runtime
NODE_ENV=development
ADMIN_AUTH_MODE=temporary
EMAIL_PROVIDER=disabled
# Required when ADMIN_AUTH_MODE=database. Generate a separate random value of at least 32 characters.
# AUTH_KEY_PEPPER=

# Postmark activation (use a verified sender and a rotated server token)
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=notifications@example.com
# POSTMARK_FROM_NAME=Chrispine Portfolio
# POSTMARK_TRANSACTIONAL_STREAM=outbound
# POSTMARK_BROADCAST_STREAM=broadcasts
# POSTMARK_WEBHOOK_USERNAME=
# POSTMARK_WEBHOOK_PASSWORD=
# NOTIFICATION_WORKER_SECRET=
# CRON_SECRET=
# APP_BASE_URL=https://example.com
# ADMIN_NOTIFICATION_EMAIL=owner@example.com
# ADMIN_INBOX_USER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# PUBLIC_WEBHOOK_BASE_URL=https://example.com
# VAPID_SUBJECT=mailto:owner@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Temporary single-administrator authentication.
# Phase 1B will replace this with database-backed users and revocable sessions.
# Configure all three values together. AUTH_SECRET should be at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# One-time CLI bootstrap only. Set these immediately before running
# `npm run admin:bootstrap`, then remove them from the environment.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# ALLOW_ADDITIONAL_SUPER_ADMIN=false

# Optional payments. Configure both values together when Stripe is enabled.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
