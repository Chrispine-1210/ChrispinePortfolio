# Development example only. Keep actual values in an ignored environment file.
NODE_ENV=development
ADMIN_AUTH_MODE=database
EMAIL_PROVIDER=disabled
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# APP_DATABASE_URL takes precedence when present; use the intended application database.
# APP_DATABASE_URL=
AUTH_KEY_PEPPER=replace-with-a-separately-generated-random-value-of-at-least-32-characters
APP_BASE_URL=http://localhost:5000

# One-time CLI bootstrap only; remove these after provisioning.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# ALLOW_ADDITIONAL_SUPER_ADMIN=false

# Optional temporary authentication requires all three values together.
# AUTH_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Configure provider credentials privately when activating an integration.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=notifications@example.com
# POSTMARK_FROM_NAME=Chrispine Portfolio
# POSTMARK_TRANSACTIONAL_STREAM=outbound
# POSTMARK_BROADCAST_STREAM=broadcasts
# POSTMARK_WEBHOOK_USERNAME=
# POSTMARK_WEBHOOK_PASSWORD=
# NOTIFICATION_WORKER_SECRET=
# CRON_SECRET=
# ADMIN_NOTIFICATION_EMAIL=owner@example.com
# ADMIN_INBOX_USER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# PUBLIC_WEBHOOK_BASE_URL=
# VAPID_SUBJECT=mailto:owner@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
